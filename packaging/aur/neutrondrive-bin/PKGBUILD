# Maintainer: SigmaCodez <maintainers@users.noreply.github.com>
pkgname=neutrondrive-bin
pkgver=0.1.0beta1
pkgrel=1
epoch=1
pkgdesc='Independent Rust/Qt Quick client for Proton Drive with automatic sync (beta)'
arch=('x86_64' 'aarch64')
url='https://github.com/SigmaCodez/NeutronDrive'
license=('MIT' 'LGPL-3.0-only')
depends=('hicolor-icon-theme' 'fuse3' 'libsecret' 'xdg-utils' 'ca-certificates'
         'glibc' 'gcc-libs' 'wayland' 'libglvnd' 'libxkbcommon-x11' 'libxcb'
         'xcb-util-cursor' 'xcb-util-wm' 'xcb-util-image' 'xcb-util-keysyms'
         'xcb-util-renderutil' 'libx11' 'fontconfig' 'freetype2' 'dbus'
         'libsm' 'libice' 'zstd' 'krb5' 'brotli')
optdepends=('gnome-keyring: Secret Service provider (or another compatible keyring)')
provides=("neutrondrive=$epoch:$pkgver")
conflicts=('neutrondrive')
options=('!strip' '!debug')
_release=0.1.0-beta1
source_x86_64=("$url/releases/download/v$_release/neutrondrive_${_release}-1_amd64.deb")
source_aarch64=("$url/releases/download/v$_release/neutrondrive_${_release}-1_arm64.deb")
sha256sums_x86_64=('19bc4ca9a72f2a23cce641dc0b8fc1ae40ee1cdbf563ae055fb3c6af7b5381e1')
sha256sums_aarch64=('8f49d90638ee9d21a2254c44bd5796bf50c3ac09f6e047f2867d79804437bb92')
noextract=("neutrondrive_${_release}-1_amd64.deb" "neutrondrive_${_release}-1_arm64.deb")

package() {
    local debarch=amd64
    [[ $CARCH == aarch64 ]] && debarch=arm64
    bsdtar -xOf "$srcdir/neutrondrive_${_release}-1_${debarch}.deb" data.tar.xz |
        bsdtar -xJf - -C "$pkgdir" ./usr
    # Arch uses /usr/lib; /usr/lib64 is a symlink owned by filesystem.
    # Keep the equivalent host extensions in /usr/lib only.
    rm -rf "$pkgdir/usr/lib64" "$pkgdir/usr/lib/x86_64-linux-gnu" "$pkgdir/usr/lib/aarch64-linux-gnu"
    mv "$pkgdir/usr/share/licenses/neutrondrive" "$pkgdir/usr/share/licenses/$pkgname"
}
