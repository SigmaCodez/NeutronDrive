#!/bin/sh
set -eu
APPDIR=$(CDPATH= cd -- "${0%/*}" && pwd -P)
export APPDIR
export LD_LIBRARY_PATH="$APPDIR/usr/lib/neutrondrive/qt/lib:$APPDIR/usr/lib:$APPDIR/usr/lib/x86_64-linux-gnu"
export QT_PLUGIN_PATH="$APPDIR/usr/lib/neutrondrive/qt/plugins"
export QML_IMPORT_PATH="$APPDIR/usr/lib/neutrondrive/qt/qml"
export QML2_IMPORT_PATH="$QML_IMPORT_PATH"
export PATH="$APPDIR/usr/bin:$APPDIR/usr/lib/neutrondrive/bin:$PATH"
exec "$APPDIR/usr/lib/neutrondrive/bin/neutrondrive-qt" --appimage-bootstrap "$APPDIR" "$@"
