{
  "app-id": "io.github.SigmaCodez.NeutronDrive",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "neutrondrive",
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--filesystem=home",
    "--talk-name=org.freedesktop.secrets",
    "--talk-name=io.github.SigmaCodez.NeutronDrive.Service",
    "--env=GTK_USE_PORTAL=1"
  ],
  "modules": [
    {
      "name": "neutrondrive",
      "buildsystem": "simple",
      "build-options": {
        "no-debuginfo": true,
        "strip": false
      },
      "build-commands": [
        "NEUTRONDRIVE_CORE_BUILD=\"$PWD/prebuilt-core\" python3 packaging/stage.py --destdir /app --prefix / --arch \"$FLATPAK_ARCH\" --backend proton-drive --portal-browser"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../..",
          "skip": [
            ".git",
            ".agents",
            ".aws",
            ".codex",
            ".env",
            "build",
            "dist",
            ".venv",
            ".flatpak-builder",
            "__pycache__",
            "core/target"
          ]
        },
        {
          "type": "file",
          "url": "https://github.com/SigmaCodez/NeutronDrive/releases/download/bridge-v0.2.0-alpha1/proton-drive-linux-x64",
          "sha512": "d99b2ccb2ec28c7783911eb352fb72364a10eb4a9c77d5a4d8b984a0298d2899368be111e4e4b2224f49abd98c44907ee2fb9b7f04684855000903c9b2e94969",
          "dest-filename": "proton-drive",
          "only-arches": [
            "x86_64"
          ]
        },
        {
          "type": "file",
          "url": "https://github.com/SigmaCodez/NeutronDrive/releases/download/bridge-v0.2.0-alpha1/proton-drive-linux-arm64",
          "sha512": "443d6975b0ab25fbab5aab63faf45d578559282d3a13823a734ec2ef8f22f850d86404adcb7fd3171e8fda9aa381e0cdd67f83ff5c10f754cde2ee6466c468fe",
          "dest-filename": "proton-drive",
          "only-arches": [
            "aarch64"
          ]
        },
        {
          "type": "file",
          "path": "../../build/rust/libneutrondrive_core.so",
          "dest": "prebuilt-core"
        },
        {
          "type": "file",
          "path": "../../build/rust/core-build.json",
          "dest": "prebuilt-core"
        },
        {
          "type": "file",
          "url": "https://files.pythonhosted.org/packages/99/20/3a6ca95052e1744b5a3eba164e2dd451d358a3dcaf78179de4b45c8e3f47/pyside6_essentials-6.10.2-cp39-abi3-manylinux_2_34_x86_64.whl",
          "sha256": "660aea45bfa36f1e06f799b934c2a7df963bd31abc5083e8bb8a5bfaef45686b",
          "dest": "build/qt-wheels/x86_64",
          "dest-filename": "pyside6_essentials-6.10.2-cp39-abi3-manylinux_2_34_x86_64.whl",
          "only-arches": [
            "x86_64"
          ]
        },
        {
          "type": "file",
          "url": "https://files.pythonhosted.org/packages/52/88/292e0576489c46624ab419ee284ac5a59ae10e2eb34a58b6abca51dfd290/shiboken6-6.10.2-cp39-abi3-manylinux_2_34_x86_64.whl",
          "sha256": "ace0790032d9cb0adda644b94ee28d59410180d9773643bb6cf8438c361987ad",
          "dest": "build/qt-wheels/x86_64",
          "dest-filename": "shiboken6-6.10.2-cp39-abi3-manylinux_2_34_x86_64.whl",
