          "dest": "build/qt-wheels/aarch64",
          "dest-filename": "pyside6_essentials-6.10.2-cp39-abi3-manylinux_2_39_aarch64.whl",
          "only-arches": [
            "aarch64"
          ]
        },
        {
          "type": "file",
          "url": "https://files.pythonhosted.org/packages/06/c2/03d44d34e8264e1f25671677fece95b414c70fd85dcc2be8d5e821ee2628/shiboken6-6.10.2-cp39-abi3-manylinux_2_39_aarch64.whl",
          "sha256": "f74d3ed1f92658077d0630c39e694eb043aeb1d830a5d275176c45d07147427f",
