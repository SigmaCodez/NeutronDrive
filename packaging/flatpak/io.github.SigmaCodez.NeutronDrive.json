{
  "app-id": "io.github.SigmaCodez.NeutronDrive",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "neutrondrive",
  "finish-args": [
    "--share=ipc",
    "--share=network",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--filesystem=home",
    "--talk-name=org.freedesktop.secrets",
    "--env=GTK_USE_PORTAL=1"
  ],
  "modules": [
    {
      "name": "neutrondrive",
      "buildsystem": "simple",
      "build-options": {"no-debuginfo": true, "strip": false},
      "build-commands": [
        "python3 packaging/stage.py --destdir /app --prefix / --arch \"$FLATPAK_ARCH\" --backend proton-drive --portal-browser"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../..",
          "skip": [".git", ".agents", ".aws", ".codex", ".env", "build", "dist", ".venv", ".flatpak-builder", "__pycache__"]
        },
        {
          "type": "file",
          "url": "https://proton.me/download/drive/cli/0.9.0/linux-x64/proton-drive",
          "sha512": "3533025ba69ae112b64e3e01fbcc1ad0688136a4043f6cf6a72886967d85fdcd9ec235479c2e113171614be5225bfba93427509a05ca5aa6071d924fa7e91ca8",
          "dest-filename": "proton-drive",
          "only-arches": ["x86_64"]
        },
        {
          "type": "file",
          "url": "https://proton.me/download/drive/cli/0.9.0/linux-arm64/proton-drive",
          "sha512": "c8d5a6b174e57f06d05cb5483400b9963faf58e743b6b33706bb73ecff718047ffce6b439994255b94b5b226b90d2e91bef7418ec96c1c3f5d8bf39b6cd01321",
          "dest-filename": "proton-drive",
          "only-arches": ["aarch64"]
        }
      ]
    }
  ]
}
