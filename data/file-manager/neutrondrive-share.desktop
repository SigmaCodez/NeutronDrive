[Desktop Entry]
Type=Action
Name=Share…
Name[de]=Teilen…
Icon=io.github.SigmaCodez.NeutronDrive
Profiles=sync;

[X-Action-Profile sync]
MimeTypes=all/all;
Schemes=file;
SelectionCount==1
Exec=/usr/bin/neutrondrive --file-action share -- %f
ShowIfTrue=/usr/lib/neutrondrive/bin/neutrondrive-file-manager %f
