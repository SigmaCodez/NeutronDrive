[Desktop Entry]
Type=Action
Name=Free up space
Name[de]=Speicherplatz freigeben
Icon=io.github.SigmaCodez.NeutronDrive
Profiles=sync;

[X-Action-Profile sync]
MimeTypes=all/all;
Schemes=file;
SelectionCount==1
Exec=/usr/bin/neutrondrive --file-action evict -- %f
ShowIfTrue=/usr/lib/neutrondrive/bin/neutrondrive-file-manager %f
