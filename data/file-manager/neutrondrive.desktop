[Desktop Entry]
Type=Service
MimeType=application/octet-stream;inode/directory;
Actions=keep;free;
X-KDE-Priority=TopLevel
X-KDE-Submenu=NeutronDrive
X-KDE-RequiredNumberOfUrls=1
X-KDE-Protocols=file

[Desktop Action keep]
Name=Keep on this device
Name[de]=Auf diesem Gerät behalten
Icon=download
Exec=neutrondrive --pin %f

[Desktop Action free]
Name=Free up local space
Name[de]=Lokalen Speicher freigeben
Icon=edit-clear
Exec=neutrondrive --evict %f
