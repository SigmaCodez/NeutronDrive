#!/usr/bin/env python3
"""Build and verify the Rust/Qt frontend in a prepared baseline build environment.

QMAKE must identify the matching Qt SDK. Run inside the supported baseline
container/rootfs; a build requiring newer libc is rejected, never published.
Python is build tooling only and is not included in the resulting artifact.
"""
import argparse
import importlib.util
import os
from pathlib import Path
import shutil
import subprocess

ROOT = Path(__file__).resolve().parents[1]
spec = importlib.util.spec_from_file_location('native_frontend', ROOT / 'packaging/native_frontend.py')
native = importlib.util.module_from_spec(spec)
spec.loader.exec_module(native)
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--output', type=Path, required=True)
parser.add_argument('--qmake', type=Path, default=os.environ.get('QMAKE'))
parser.add_argument('--target-dir', type=Path, default=os.environ.get('CARGO_TARGET_DIR', ROOT / 'build/native-qt-target'))
parser.add_argument('--vendor-cache', type=Path, help='Optional local copy of the checksum-verified vendored crates')
args = parser.parse_args()
if not args.qmake or not args.qmake.is_file():
    parser.error('Set QMAKE or --qmake to a prepared Qt 6.10.2 SDK')
source_before = native.sources()
env = dict(os.environ, QMAKE=str(args.qmake.resolve()), CARGO_TARGET_DIR=str(args.target_dir.resolve()), CARGO_INCREMENTAL='0')
if not shutil.which('ld.lld', path=env.get('PATH')):
    toolchain = Path(subprocess.check_output(['rustc', '--print', 'sysroot'], text=True).strip())
    host = next(line.split(': ', 1)[1] for line in subprocess.check_output(['rustc', '-vV'], text=True).splitlines() if line.startswith('host: '))
    linker = toolchain/'lib/rustlib'/host/'bin/gcc-ld'
    if not (linker/'ld.lld').is_file():
        raise SystemExit('Install LLVM lld or use the pinned Rust toolchain with its bundled linker')
    env['PATH'] = str(linker)+os.pathsep+env.get('PATH', '')
if '-fuse-ld=' not in env.get('RUSTFLAGS', ''):
    env['RUSTFLAGS'] = (env.get('RUSTFLAGS', '')+' -C link-arg=-fuse-ld=lld').strip()
command = ['cargo', 'build', '--release', '--locked', '--offline']
if args.vendor_cache:
    import json
    command += ['--config', 'source.vendored-sources.directory='+json.dumps(str(args.vendor_cache.resolve()))]
subprocess.run(command, cwd=ROOT / 'desktop', env=env, check=True)
subprocess.run(command, cwd=ROOT / 'file-manager', env=env, check=True)
plugin_dir = args.target_dir.resolve() / 'release'
shutil.copyfile(plugin_dir/'libneutrondrive_file_manager.so', plugin_dir/'libneutrondrive-modern.so')
subprocess.run(command + ['--features', 'nautilus3', '--lib'], cwd=ROOT / 'file-manager', env=env, check=True)
shutil.copyfile(plugin_dir/'libneutrondrive_file_manager.so', plugin_dir/'libneutrondrive_nautilus3.so')
shutil.copyfile(plugin_dir/'libneutrondrive-modern.so', plugin_dir/'libneutrondrive_file_manager.so')
if native.sources() != source_before:
    raise SystemExit('Sources changed during the build; refusing to publish inconsistent provenance')
binary = args.target_dir.resolve() / 'release' / native.BINARY
print(native.record(binary, args.output.resolve()))
