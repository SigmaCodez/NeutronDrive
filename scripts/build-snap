#!/usr/bin/env python3
"""Create an isolated Snapcraft project and build a local strict snap."""
import argparse
import importlib.util
import json
import os
from pathlib import Path
import shutil
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent
spec = importlib.util.spec_from_file_location("fetch_backend", ROOT / "packaging/fetch-backend.py")
backend = importlib.util.module_from_spec(spec)
spec.loader.exec_module(backend)
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--arch", choices=("amd64", "arm64"), default="amd64" if backend.architecture() == "x86_64" else "arm64")
parser.add_argument("--destructive-mode", action="store_true", help="Build directly on an expendable Ubuntu 24.04 build host")
parser.add_argument("--backend", type=Path, help="Use a downloaded binary; its SHA-512 is still checked")
parser.add_argument("--prepare-only", type=Path, help="Write the project to a new directory without invoking Snapcraft")
args = parser.parse_args()
if not args.prepare_only and not shutil.which("snapcraft"):
    parser.error("snapcraft is required (or use --prepare-only DIRECTORY)")
binary = args.backend or backend.fetch(ROOT / "build/backend" / backend.architecture(args.arch) / "proton-drive", args.arch)
backend.verify(binary, json.loads(backend.LOCK.read_text())["architectures"][backend.architecture(args.arch)]["sha512"])


def prepare(project):
    rust_spec = importlib.util.spec_from_file_location("rust_build", ROOT / "packaging/rust_core.py")
    rust_build = importlib.util.module_from_spec(rust_spec)
    rust_spec.loader.exec_module(rust_build)
    core = Path(os.environ["NEUTRONDRIVE_CORE_BUILD"]).resolve() if os.environ.get("NEUTRONDRIVE_CORE_BUILD") else rust_build.build()
    rust_build.verify(core, args.arch)
    target = project / "native-core" / args.arch
    target.mkdir(parents=True)
    for name in (rust_build.LIBRARY, "core-build.json"):
        shutil.copyfile(core / name, target / name)
    for name in ("src", "data", "packaging", "core"):
        shutil.copytree(ROOT / name, project / name, ignore=shutil.ignore_patterns("__pycache__", "*.pyc", "target"))
    shutil.copyfile(ROOT / "LICENSE", project / "LICENSE")
    (project / "snap").mkdir()
    shutil.copyfile(ROOT / "packaging/snap/snapcraft.yaml", project / "snap/snapcraft.yaml")
    (project / "backend" / args.arch).mkdir(parents=True)
    shutil.copyfile(binary, project / "backend" / args.arch / "proton-drive")


if args.prepare_only:
    args.prepare_only.mkdir(parents=True, exist_ok=False)
    prepare(args.prepare_only.resolve())
    print(args.prepare_only.resolve())
else:
    with tempfile.TemporaryDirectory(prefix="neutrondrive-snap-") as temporary:
        project = Path(temporary)
        prepare(project)
        command = ["snapcraft", f"--build-for={args.arch}"]
        if args.destructive_mode:
            command.append("--destructive-mode")
        subprocess.run(command, cwd=project, check=True)
        (ROOT / "dist").mkdir(exist_ok=True)
        packages = list(project.glob("*.snap"))
        if not packages:
            raise RuntimeError("Snapcraft succeeded without producing a .snap")
        for package in packages:
            target = ROOT / "dist" / package.name
            shutil.copyfile(package, target)
            print(target)
