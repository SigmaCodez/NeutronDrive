#!/usr/bin/env python3
"""Create an isolated Snapcraft project and build a local strict snap."""
import argparse
import importlib.util
import json
import os
from pathlib import Path
import shutil
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent
spec = importlib.util.spec_from_file_location("fetch_backend", ROOT / "packaging/fetch-backend.py")
backend = importlib.util.module_from_spec(spec)
spec.loader.exec_module(backend)
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--arch", choices=("amd64", "arm64"), default="amd64" if backend.architecture() == "x86_64" else "arm64")
parser.add_argument("--destructive-mode", action="store_true", help="Build directly on an expendable Ubuntu 24.04 build host")
parser.add_argument("--backend", type=Path, help="Use a downloaded binary; its SHA-512 is still checked")
parser.add_argument("--prepare-only", type=Path, help="Write the project to a new directory without invoking Snapcraft")
args = parser.parse_args()
if not args.prepare_only and not shutil.which("snapcraft"):
    parser.error("snapcraft is required (or use --prepare-only DIRECTORY)")
binary = args.backend or ROOT / "build/backend/proton-drive"
if not binary.is_file():
    parser.error("Build the current pinned SDK with scripts/build-backend or pass --backend")
try:
    backend.verify(binary, json.loads(backend.LOCK.read_text())["architectures"][backend.architecture(args.arch)]["sha512"])
except ValueError:
    backend.verify_source_build(binary, args.arch)


def prepare(project):
    native_spec = importlib.util.spec_from_file_location("native_frontend", ROOT / "packaging/native_frontend.py")
    native = importlib.util.module_from_spec(native_spec)
    native_spec.loader.exec_module(native)
    if not os.environ.get("NEUTRONDRIVE_NATIVE_BUILD"):
        raise RuntimeError("Set NEUTRONDRIVE_NATIVE_BUILD to a verified Rust/Qt frontend build")
    frontend = Path(os.environ["NEUTRONDRIVE_NATIVE_BUILD"]).resolve()
    native.verify(frontend, args.arch)
    target = project / "native-frontend" / args.arch
    target.mkdir(parents=True)
    for name in (native.BINARY, native.REPORT, *native.FILE_MANAGER_ARTIFACTS):
        shutil.copyfile(frontend / name, target / name)
    qt_spec = importlib.util.spec_from_file_location("qt_runtime", ROOT / "packaging/qt_runtime.py")
    qt_runtime = importlib.util.module_from_spec(qt_spec)
    qt_spec.loader.exec_module(qt_runtime)
    wheels = qt_runtime.fetch(args.arch)
    qt_dest = project / "build/qt-wheels" / qt_runtime.arch(args.arch)
    qt_dest.mkdir(parents=True)
    for wheel in wheels:
        shutil.copyfile(wheel, qt_dest / wheel.name)
    def ignore_build_cache(directory, names):
        ignored = set(shutil.ignore_patterns("__pycache__", "*.pyc", "target")(directory, names))
        if Path(directory) == ROOT / "core":
            ignored.add("vendor")
        return ignored
    for name in ("src", "data", "packaging", "core", "desktop", "file-manager"):
        shutil.copytree(ROOT / name, project / name, ignore=ignore_build_cache)
    # Validate the isolated source copy as well as the original checkout.
    original_root = native.ROOT
    try:
        native.ROOT = project
        native.verify(project / "native-frontend" / args.arch, args.arch)
    finally:
        native.ROOT = original_root
    # This project stages a prebuilt, verified executable; retain dependency
    # notices without copying the entire compiler dependency source cache.
    for crate in (ROOT / "core/vendor").iterdir():
        if crate.is_dir():
            for notice in crate.glob("LICENSE*"):
                if notice.is_file():
                    target = project / "core/vendor" / crate.name / notice.name
                    target.parent.mkdir(parents=True, exist_ok=True)
                    shutil.copyfile(notice, target)
    (project / "scripts").mkdir()
    shutil.copyfile(ROOT / "scripts/build-backend", project / "scripts/build-backend")
    shutil.copyfile(ROOT / "LICENSE", project / "LICENSE")
    (project / "snap").mkdir()
    shutil.copyfile(ROOT / "packaging/snap/snapcraft.yaml", project / "snap/snapcraft.yaml")
    (project / "backend" / args.arch).mkdir(parents=True)
    shutil.copyfile(binary, project / "backend" / args.arch / "proton-drive")
    provenance = Path(binary).with_name(Path(binary).name + ".provenance.json")
    if provenance.exists():
        shutil.copyfile(provenance, project / "backend" / args.arch / "proton-drive.provenance.json")


if args.prepare_only:
    args.prepare_only.mkdir(parents=True, exist_ok=False)
    prepare(args.prepare_only.resolve())
    print(args.prepare_only.resolve())
else:
    with tempfile.TemporaryDirectory(prefix="neutrondrive-snap-") as temporary:
        project = Path(temporary)
        prepare(project)
        command = ["snapcraft", f"--build-for={args.arch}"]
        if args.destructive_mode:
            command.append("--destructive-mode")
        subprocess.run(command, cwd=project, check=True)
        (ROOT / "dist").mkdir(exist_ok=True)
        packages = list(project.glob("*.snap"))
        if not packages:
            raise RuntimeError("Snapcraft succeeded without producing a .snap")
        for package in packages:
            target = ROOT / "dist" / package.name
            shutil.copyfile(package, target)
            print(target)
